# Admin login (set in the Netlify dashboard, never commit real values)
ADMIN_EMAIL=admin@example.com
# Generate with: npm run hash-password -- "your-long-password"
ADMIN_PASSWORD_HASH=scrypt$salt$hash
# Random string of 32+ characters (openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-value

# EmailJS contact form (public by design: restrict allowed domains in the EmailJS dashboard)
EMAILJS_PUBLIC_KEY=your-public-key
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
